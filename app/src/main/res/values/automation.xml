    <string name="automation_title" translatable="false">Automation · tvQuickActions</string>
    <string name="automation_help" translatable="false">Create shortcuts in tvQuickActions → Custom actions → Shortcuts → Red Moon TV. Broadcasts preserve playback focus. Temporary controls preserve saved profiles; native phase caps still apply. Left/Right adjusts numbers, OK saves.</string>
